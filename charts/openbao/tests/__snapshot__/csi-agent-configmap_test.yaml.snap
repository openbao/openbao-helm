allows overriding the namespace:
  1: |
    apiVersion: v1
    data:
      config.hcl: |
        vault {
            "address" = "http://RELEASE-NAME-openbao.bar.svc:8200"
        }

        cache {}

        listener "unix" {
            address = "/var/run/vault/agent.sock"
            tls_disable = true
        }
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openbao-csi-provider
        helm.sh/chart: openbao-0.30.3
      name: RELEASE-NAME-openbao-csi-provider-agent-config
      namespace: bar
is not affected by the injector's OpenBao address:
  1: |
    apiVersion: v1
    data:
      config.hcl: |
        vault {
            "address" = "http://RELEASE-NAME-openbao.NAMESPACE.svc:8200"
        }

        cache {}

        listener "unix" {
            address = "/var/run/vault/agent.sock"
            tls_disable = true
        }
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openbao-csi-provider
        helm.sh/chart: openbao-0.30.3
      name: RELEASE-NAME-openbao-csi-provider-agent-config
      namespace: NAMESPACE
