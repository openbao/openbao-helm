        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openbao
        helm.sh/chart: openbao-0.30.3
      name: NAMESPACE-RELEASE-NAME-openbao-server-binding
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
