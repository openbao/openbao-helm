        #}
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openbao
        helm.sh/chart: openbao-0.30.3
      name: RELEASE-NAME-openbao-config
      namespace: NAMESPACE
