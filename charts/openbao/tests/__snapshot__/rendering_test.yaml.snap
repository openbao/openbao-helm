        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openbao
      name: RELEASE-NAME-openbao
      namespace: NAMESPACE
    spec:
      podManagementPolicy: OrderedReady
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: openbao
          component: server
      serviceName: RELEASE-NAME-openbao-internal
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: openbao
            component: server
            helm.sh/chart: openbao-0.30.3
        spec:
          containers:
            - args:
                - "/usr/local/bin/docker-entrypoint.sh bao server -dev \n"
              command:
                - /bin/sh
                - -ec
              env:
                - name: HOST_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: BAO_K8S_POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: BAO_K8S_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: BAO_ADDR
                  value: http://127.0.0.1:8200
                - name: BAO_API_ADDR
                  value: http://$(POD_IP):8200
                - name: SKIP_CHOWN
                  value: "true"
                - name: SKIP_SETCAP
                  value: "true"
                - name: HOSTNAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: BAO_CLUSTER_ADDR
                  value: https://$(HOSTNAME).RELEASE-NAME-openbao-internal:8201
                - name: HOME
                  value: /home/openbao
                - name: VAULT_DEV_ROOT_TOKEN_ID
                  value: root
                - name: VAULT_DEV_LISTEN_ADDRESS
                  value: '[::]:8200'
              image: quay.io/openbao/openbao:2.7.1
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  exec:
                    command:
                      - /bin/sh
                      - -c
                      - sleep 5 && kill -SIGTERM $(pidof bao)
              name: openbao
              ports:
                - containerPort: 8200
                  name: http
                - containerPort: 8201
                  name: https-internal
                - containerPort: 8202
                  name: http-rep
              readinessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -ec
                    - bao status -tls-skip-verify
                failureThreshold: 2
                initialDelaySeconds: 5
                periodSeconds: 5
                successThreshold: 1
                timeoutSeconds: 3
              securityContext:
                allowPrivilegeEscalation: false
              volumeMounts:
                - mountPath: /home/openbao
                  name: home
          hostNetwork: false
          securityContext:
            fsGroup: 1000
            runAsGroup: 1000
            runAsNonRoot: true
            runAsUser: 100
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-openbao
          terminationGracePeriodSeconds: 10
          volumes:
            - emptyDir: {}
              name: home
      updateStrategy:
        type: OnDelete
  12: |
    apiVersion: v1
    kind: Pod
    metadata:
      annotations:
        helm.sh/hook: test
      name: RELEASE-NAME-openbao-server-test
      namespace: NAMESPACE
    spec:
      containers:
        - command:
            - /bin/sh
            - -c
            - |
              echo "Checking for sealed info in 'bao status' output"
              ATTEMPTS=10
              n=0
              until [ "$n" -ge $ATTEMPTS ]
              do
                echo "Attempt" $n...
                bao status -format yaml | grep -E '^sealed: (true|false)' && break
                n=$((n+1))
                sleep 5
              done
              if [ $n -ge $ATTEMPTS ]; then
                echo "timed out looking for sealed info in 'bao status' output"
                exit 1
              fi

              exit 0
          env:
            - name: VAULT_ADDR
              value: http://RELEASE-NAME-openbao.NAMESPACE.svc:8200
          image: quay.io/openbao/openbao:2.7.1
          imagePullPolicy: IfNotPresent
          name: RELEASE-NAME-server-test
          securityContext:
            allowPrivilegeEscalation: false
          volumeMounts: null
      restartPolicy: Never
      securityContext:
        fsGroup: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 100
        seccompProfile:
          type: RuntimeDefault
      volumes: null
