              startupProbe:
                failureThreshold: 12
                httpGet:
                  path: /health/ready
                  port: 8080
                  scheme: HTTPS
                initialDelaySeconds: 5
                periodSeconds: 5
                successThreshold: 1
                timeoutSeconds: 5
